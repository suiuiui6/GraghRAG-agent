          "openai": "langextract.providers.openai:OpenAILanguageModel"
        }
      }
    },
    "tool": {
      "setuptools": {
        "packages": [
          "langextract",
          "langextract._compat",
          "langextract.core",
          "langextract.providers",
          "langextract.providers.schemas"
        ],
        "include-package-data": true,
        "package-data": {
          "langextract": [
            "py.typed"
          ]
        },
        "exclude-package-data": {
          "*": [
            "docs*",
            "tests*",
            "kokoro*",
            "*.gif",
            "*.svg"
          ]
        }
      },
      "pytest": {
        "ini_options": {
          "testpaths": [
            "tests"
          ],
          "python_files": "*_test.py",
          "python_classes": "Test*",
          "python_functions": "test_*",
          "addopts": "-ra",
          "markers": [
            "live_api: marks tests as requiring live API access",
            "requires_pip: marks tests that perform pip install/uninstall operations",
            "integration: marks integration tests that test multiple components together"
          ]
        }
      },
      "pyink": {
        "line-length": 80,
        "unstable": true,
        "pyink-indentation": 2,
        "pyink-use-majority-quotes": true
      },
      "isort": {
        "profile": "google",
        "line_length": 80,
        "force_sort_within_sections": true,
        "single_line_exclusions": [
          "typing",
          "typing_extensions",
          "collections.abc"
        ]
      },
      "importlinter": {
        "root_package": "langextract",
        "contracts": [
          {
            "name": "Providers must not import inference",
            "type": "forbidden",
            "source_modules": [
              "langextract.providers"
            ],
            "forbidden_modules": [
              "langextract.inference"
            ]
          },
          {
            "name": "Core must not import providers",
            "type": "forbidden",
            "source_modules": [
              "langextract.core"
            ],
            "forbidden_modules": [
              "langextract.providers"
            ]
          },
