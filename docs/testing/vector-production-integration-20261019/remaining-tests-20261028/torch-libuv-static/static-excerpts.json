          "21: def create_pinned_embedding(snapshot, profile):",
          "22:     \"\"\"Load exactly the hash-registered local model; never resolve a model ID.\"\"\"",
          "23:     try:",
          "24:         root = Path(snapshot).resolve(strict=True)",
          "25:         manifest = profile['files_sha256']",
          "26:         if (not root.is_dir() or type(manifest) is not dict or not manifest",
          "27:                 or not profile.get('model') or not profile.get('revision')",
          "28:                 or type(profile.get('dimension')) is not int or profile['dimension'] < 1",
          "29:                 or profile.get('normalize') is not True):",
          "30:             raise ValueError('invalid profile')",
          "31:         for name, expected in manifest.items():",
          "32:             relative = Path(name)",
          "33:             if relative.is_absolute() or relative.drive or '..' in relative.parts:",
          "34:                 raise ValueError('invalid asset path')",
          "35:             digest = hashlib.sha256()",
          "36:             with (root / relative).open('rb') as source:",
          "37:                 for block in iter(lambda: source.read(65536), b''):",
          "38:                     digest.update(block)",
          "39:             if digest.hexdigest() != expected:",
          "40:                 raise ValueError('model identity changed')",
          "41:         required = {'config.json', 'modules.json', 'model.safetensors', 'tokenizer_config.json',",
          "42:                     'tokenizer.json', '1_Pooling/config.json'}",
          "43:         if not required.issubset(manifest):",
          "44:             raise ValueError('incomplete model identity')",
