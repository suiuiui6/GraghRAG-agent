          "64:         str: Device name, like 'cuda:2', 'mps', 'npu', 'xpu', 'hpu', or 'cpu'",
          "65:     \"\"\"",
          "66:     if torch.cuda.is_available():",
          "67:         if \"LOCAL_RANK\" in os.environ:",
          "68:             local_rank = int(os.environ[\"LOCAL_RANK\"])",
          "69:         elif is_dist_initialized() and torch.cuda.device_count() > torch.distributed.get_rank():",
          "70:             local_rank = torch.distributed.get_rank()",
          "71:         else:",
          "72:             local_rank = 0",
          "73:         return f\"cuda:{local_rank}\"",
          "74:     elif torch.backends.mps.is_available():",
          "75:         return \"mps\"",
          "76:     elif is_torch_npu_available():",
          "77:         return \"npu\"",
          "78:     elif hasattr(torch, \"xpu\") and torch.xpu.is_available():",
